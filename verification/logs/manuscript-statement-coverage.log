BerryEsseen.extremizer_support_limit_separation_general (H : BerryEsseen.ClassicalBerryEsseenBounds)
  (W : BerryEsseen.PublishedWassersteinThreeTopology) (S : BerryEsseen.PublishedSignedSmoothing)
  (P : ℕ → BerryEsseen.StandardizedLaw) (n : ℕ → ℕ) (t : ℕ → ℝ) (hn : Filter.Tendsto n Filter.atTop Filter.atTop)
  (hattain : ∀ (j : ℕ), BerryEsseen.signedRatio (P j) (n j) (t j) = BerryEsseen.extremalConstant (n j + 1))
  (hv : ∀ (j : ℕ), BerryEsseen.cE < BerryEsseen.extremalConstant (n j + 1))
  (hd : Filter.Tendsto (fun j => BerryEsseen.scaledDrop BerryEsseen.extremalConstant (n j + 1)) Filter.atTop (nhds 0))
  (hw :
    Filter.Tendsto (fun j => (P j).toProbabilityMeasure) Filter.atTop (nhds BerryEsseen.esseenLaw.toProbabilityMeasure))
  (hz : Filter.Tendsto (fun j => t j / √(↑(n j) + 1)) Filter.atTop (nhds 0)) (x y : ℕ → ℝ) (a b : ℝ)
  (hxsupp : ∀ (j : ℕ), x j ∈ (P j).measure.support) (hysupp : ∀ (j : ℕ), y j ∈ (P j).measure.support)
  (hx : Filter.Tendsto x Filter.atTop (nhds a)) (hy : Filter.Tendsto y Filter.atTop (nhds b)) :
  a = b ∨ BerryEsseen.hE ≤ |a - b|
BerryEsseen.effective_selection (H : BerryEsseen.ClassicalBerryEsseenBounds) (N : ℕ) (hN : 4 ≤ N)
  (hviol : BerryEsseen.cE < BerryEsseen.extremalConstant N) :
  ∃ n,
    ⌈↑N / 2⌉₊ ≤ n ∧
      n ≤ N ∧
        BerryEsseen.cE < BerryEsseen.extremalConstant n ∧
          BerryEsseen.scaledDrop BerryEsseen.extremalConstant n < 86e-3 ∧
            BerryEsseen.scaledDrop BerryEsseen.extremalConstant n ≤ 10 / √↑(N - 2) ∧
              ∀ (P : BerryEsseen.StandardizedLaw) (t : ℝ),
                BerryEsseen.signedRatio P (n - 1) t = BerryEsseen.extremalConstant n →
                  P.measure.support ⊆ Set.Icc (-6) 6
BerryEsseen.effectiveLowFrequencyIntegral_bound (P : BerryEsseen.StandardizedLaw)
  (hβ : BerryEsseen.thirdMoment P ≤ 1.84) (hb : ∀ᵐ (x : ℝ) ∂P.measure, |x| ≤ 6) (n : ℕ) (hn : 2 ≤ n) :
  ∫ (t : ℝ) in BerryEsseen.effectiveLowFrequencyRange n, BerryEsseen.fourierEdgeworthError P n t ≤ 6 / ↑n
BerryEsseen.effective_charFun_edgeworth_low_frequency (P : BerryEsseen.StandardizedLaw)
  (hβ : BerryEsseen.thirdMoment P ≤ 1.84) (hb : ∀ᵐ (x : ℝ) ∂P.measure, |x| ≤ 6) (n : ℕ) (hn : 2 ≤ n) (t : ℝ)
  (ht : |t| ≤ √↑n / 2) :
  ‖MeasureTheory.charFun P.measure (t / √↑n) ^ n - BerryEsseen.edgeworthChar n (BerryEsseen.signedThirdMoment P) t‖ ≤
    (0.61 * |t| ^ 4 * Real.exp (-0.35 * t ^ 2) + 48e-3 * |t| ^ 6 * Real.exp (-t ^ 2 / 2)) / ↑n
BerryEsseen.effective_near_lattice (H : BerryEsseen.ClassicalBerryEsseenBounds)
  (S : BerryEsseen.PublishedSignedSmoothing) (P : BerryEsseen.StandardizedLaw) (n : ℕ) (hn : 1024 ≤ n)
  (hsupp : P.measure.support ⊆ Set.Icc (-6) 6) (hviol : ¬BerryEsseen.BoundAt P n) :
  ∃ a h,
    Real.pi / 500 ≤ h ∧
      h ≤ 4 * Real.pi ∧
        MeasureTheory.Integrable (fun x => Metric.infDist x (BerryEsseen.affineLattice a h) ^ 2) P.measure ∧
          ∫ (x : ℝ), Metric.infDist x (BerryEsseen.affineLattice a h) ^ 2 ∂P.measure ≤
            2 * Real.pi ^ 2 * Real.log ↑n / ↑n
BerryEsseen.effective_cluster_jitter (S : BerryEsseen.PublishedSignedSmoothing) (P Q : BerryEsseen.CenteredFourthLaw)
  (p ε T : ℝ) (hp : p ∈ Set.Icc (2 / 5) (9 / 20)) (hp01 : p ∈ Set.Ioo 0 1) (hε : 0 ≤ ε) (hT : 10 ≤ T)
  (hεT : ε ≤ (100 * T)⁻¹) (hP : ∀ᵐ (x : ℝ) ∂P.measure, |x| ≤ ε) (hQ : ∀ᵐ (x : ℝ) ∂Q.measure, |x| ≤ ε) (n : ℕ)
  (hn : 1000000 ≤ n) :
  √↑n *
      sSup
        (Set.range fun x =>
          |↑(ProbabilityTheory.cdf
                    ((BerryEsseen.iidSumLaw (BerryEsseen.twoClusterMeasure P Q p) n).conv
                      (BerryEsseen.uniformJitter 1)))
                x -
              BerryEsseen.edgeworthCDF n
                (BerryEsseen.signedThirdMoment (BerryEsseen.standardizedTwoClusterLaw P Q p hp01))
                ((x - ↑n * p) / (√(BerryEsseen.clusterVariance P Q p) * √↑n))|) ≤
    BerryEsseen.effectiveClusterError n ε T
BerryEsseen.manuscript_effective_binomial_branches (p : ℝ) (hp : p ∈ Set.Icc (2 / 5) (9 / 20)) (n : ℕ)
  (hn : 10 ^ 100 ≤ n) (k : ℤ) :
  |BerryEsseen.binomialUpperBranch p n k - BerryEsseen.binomialUpperEnvelope p (BerryEsseen.binomialZ p n k)| ≤
      2 / 10 ^ 10 ∧
    |BerryEsseen.binomialLowerBranch p n k - BerryEsseen.binomialLowerEnvelope p (BerryEsseen.binomialZ p n k)| ≤
      2 / 10 ^ 10
BerryEsseen.manuscript_effective_binomial_mass_sup (p : ℝ) (hp : p ∈ Set.Icc (2 / 5) (9 / 20)) (n : ℕ) (hn : 1 ≤ n) :
  sSup (Set.range (BerryEsseen.binomialIntegerWeight p n)) ≤ 2 / √↑n
BerryEsseen.manuscript_effective_binomial_integer_central (p : ℝ) (hp : p ∈ Set.Icc (2 / 5) (9 / 20)) (n : ℕ)
  (hn : 10 ^ 100 ≤ n) (k : ℤ) (hz : |BerryEsseen.binomialZ p n k| ≤ 5) :
  0.99 ≤
      √(↑n * p * (1 - p)) * BerryEsseen.binomialIntegerWeight p n k /
        BerryEsseen.standardNormalDensity (BerryEsseen.binomialZ p n k) ∧
    √(↑n * p * (1 - p)) * BerryEsseen.binomialIntegerWeight p n k /
          BerryEsseen.standardNormalDensity (BerryEsseen.binomialZ p n k) ≤
        1.01 ∧
      1 / 10 ^ 6 / √↑n ≤ BerryEsseen.binomialIntegerWeight p n k
BerryEsseen.manuscript_effective_binomial_integer_wide (p : ℝ) (hp : p ∈ Set.Icc (2 / 5) (9 / 20)) (n : ℕ)
  (hn : 10 ^ 100 ≤ n) (k : ℤ) (hz : |BerryEsseen.binomialZ p n k| ≤ 11) :
  Real.exp (-100) / √↑n ≤ BerryEsseen.binomialIntegerWeight p n k
BerryEsseen.manuscript_effective_binomial_constant_lower (p : ℝ) (hp : p ∈ Set.Icc (2 / 5) (9 / 20)) (n : ℕ)
  (hn : 10 ^ 100 ≤ n) :
  BerryEsseen.binomialCentralLimit p - 3 / 10 ^ 10 ≤ BerryEsseen.binomialNormalizedConstant p n ∧
    0.39 < BerryEsseen.binomialNormalizedConstant p n
BerryEsseen.manuscript_effective_small_variance (B : BerryEsseen.PublishedBernoulliBound)
  (U : BerryEsseen.PublishedNonuniformBound) (P Q : BerryEsseen.CenteredFourthLaw) (p ε : ℝ)
  (hp : p ∈ Set.Icc (2 / 5) (9 / 20)) (hε : ε ∈ Set.Icc 0 (1 / 10 ^ 12)) (hP : ∀ᵐ (x : ℝ) ∂P.measure, |x| ≤ ε)
  (hQ : ∀ᵐ (x : ℝ) ∂Q.measure, |x| ≤ ε) (n : ℕ) (hn : 10 ^ 100 ≤ n)
  (hlam : BerryEsseen.accumulatedNoiseVariance P Q p n ≤ 1 / 10 ^ 12) :
  sSup (Set.range (BerryEsseen.normalizedDiscrepancy (BerryEsseen.standardizedTwoClusterLaw P Q p ⋯) n)) ≤
      BerryEsseen.binomialNormalizedConstant p n ∧
    BerryEsseen.binomialNormalizedConstant p n < BerryEsseen.cE
BerryEsseen.manuscript_effective_small_variance_positive (B : BerryEsseen.PublishedBernoulliBound)
  (U : BerryEsseen.PublishedNonuniformBound) (P Q : BerryEsseen.CenteredFourthLaw) (p ε : ℝ)
  (hp : p ∈ Set.Icc (2 / 5) (9 / 20)) (hε : ε ∈ Set.Icc 0 (1 / 10 ^ 12)) (hP : ∀ᵐ (x : ℝ) ∂P.measure, |x| ≤ ε)
  (hQ : ∀ᵐ (x : ℝ) ∂Q.measure, |x| ≤ ε) (n : ℕ) (hn : 10 ^ 100 ≤ n)
  (hlam : BerryEsseen.accumulatedNoiseVariance P Q p n ∈ Set.Ioc 0 (1 / 10 ^ 12)) :
  sSup (Set.range (BerryEsseen.normalizedDiscrepancy (BerryEsseen.standardizedTwoClusterLaw P Q p ⋯) n)) ≤
    BerryEsseen.binomialNormalizedConstant p n -
      BerryEsseen.effectiveSmallVarianceGap (BerryEsseen.accumulatedNoiseVariance P Q p n) ε
BerryEsseen.manuscript_effective_local_mass (I : BerryEsseen.PublishedNonIIDBound) (P Q : BerryEsseen.CenteredFourthLaw)
  (p : ℝ) (hp : p ∈ Set.Icc (2 / 5) (9 / 20)) (hP : ∀ᵐ (x : ℝ) ∂P.measure, |x| ≤ Real.exp (-BerryEsseen.appendixA))
  (hQ : ∀ᵐ (x : ℝ) ∂Q.measure, |x| ≤ Real.exp (-BerryEsseen.appendixA)) (n : ℕ) (hn : 10 ^ 100 ≤ n)
  (hlam : 1 / 10 ^ 12 ≤ BerryEsseen.accumulatedNoiseVariance P Q p n) (a b : ℝ) (ha : |a| ≤ 1 / 2) (hb : |b| ≤ 1 / 2)
  (hab : 1 / 4 ≤ b - a) :
  Real.exp (-4000000000000) / √↑n ≤
    sInf
      (Set.range fun x =>
        (BerryEsseen.iidSumLaw (BerryEsseen.twoClusterMeasure P Q p) n).real (Set.Ioo (↑x + a) (↑x + b)))
BerryEsseen.manuscript_effective_cluster_stability (B : BerryEsseen.PublishedBernoulliBound)
  (I : BerryEsseen.PublishedNonIIDBound) (U : BerryEsseen.PublishedNonuniformBound)
  (P Q : BerryEsseen.CenteredFourthLaw) (p : ℝ) (hp : p ∈ Set.Icc (2 / 5) (9 / 20))
  (hP : ∀ᵐ (x : ℝ) ∂P.measure, |x| ≤ Real.exp (-BerryEsseen.appendixA))
  (hQ : ∀ᵐ (x : ℝ) ∂Q.measure, |x| ≤ Real.exp (-BerryEsseen.appendixA)) (n : ℕ) (hn : BerryEsseen.appendixNStar ≤ n) :
  sSup (Set.range (BerryEsseen.normalizedDiscrepancy (BerryEsseen.standardizedTwoClusterLaw P Q p ⋯) n)) <
    BerryEsseen.cE
BerryEsseen.manuscript_effective_interval_stability_support (B : BerryEsseen.PublishedBernoulliBound)
  (I : BerryEsseen.PublishedNonIIDBound) (U : BerryEsseen.PublishedNonuniformBound) (μ : MeasureTheory.Measure ℝ)
  [MeasureTheory.IsProbabilityMeasure μ]
  (hb :
    μ.support ⊆
      Set.Icc (-BerryEsseen.appendixEtaStar) BerryEsseen.appendixEtaStar ∪
        Set.Icc (1 - BerryEsseen.appendixEtaStar) (1 + BerryEsseen.appendixEtaStar))
  (hp :
    |μ.real (Set.Icc (1 - BerryEsseen.appendixEtaStar) (1 + BerryEsseen.appendixEtaStar)) - BerryEsseen.pE| <
        BerryEsseen.appendixEtaStar ∨
      |μ.real (Set.Icc (1 - BerryEsseen.appendixEtaStar) (1 + BerryEsseen.appendixEtaStar)) - (1 - BerryEsseen.pE)| <
        BerryEsseen.appendixEtaStar)
  (n : ℕ) (hn : BerryEsseen.appendixNStar ≤ n) : BerryEsseen.rawNormalizedConstant μ n < BerryEsseen.cE
BerryEsseen.effective_lattice_stability (K : BerryEsseen.PublishedWassersteinDuality) (P : BerryEsseen.StandardizedLaw)
  (h δ : ℝ) (hsupp : P.measure.support ⊆ Set.Icc (-15) 15) (hlat : BerryEsseen.IsLatticeSpan P.measure h)
  (hβ : BerryEsseen.thirdMoment P ≤ 2) (hD : BerryEsseen.latticeMomentDeficit P h ∈ Set.Icc 0 δ) (hδ : δ ≤ 1 / 10 ^ 6) :
  ∃ ε ∈ {-1, 1},
    BerryEsseen.wassersteinOne P.measure (MeasureTheory.Measure.map (fun x => ε * x) BerryEsseen.esseenLaw.measure) ≤
        1000 * √δ ∧
      |h - BerryEsseen.hE| ≤ 1000 * √δ
BerryEsseen.effective_global_jitter (H : BerryEsseen.ClassicalBerryEsseenBounds)
  (S : BerryEsseen.PublishedSignedSmoothing) (E : BerryEsseen.PublishedEsseenMoment)
  (K : BerryEsseen.PublishedWassersteinDuality) (P : BerryEsseen.StandardizedLaw) (n : ℕ)
  (hn : BerryEsseen.appendixNConf ≤ n) (hsupp : P.measure.support ⊆ Set.Icc (-6) 6) (hviol : ¬BerryEsseen.BoundAt P n) :
  ∃ Q F h Z,
    MeasureTheory.IsProbabilityMeasure Q ∧
      F.card < 2000 ∧
        Q.support ⊆ ↑F ∧
          (∀ x ∈ F, |x| < 13) ∧
            (∀ x ∈ F, BerryEsseen.appendixRetention ≤ Q.real {x}) ∧
              h ∈ Set.Icc (Real.pi / 500) 5 ∧
                BerryEsseen.IsLatticeSpan Q h ∧
                  (∀ (d : ℝ), BerryEsseen.IsLatticeSpan Q d → d ≤ h) ∧
                    BerryEsseen.wassersteinOne P.measure Q ≤ 10 ^ 5 * BerryEsseen.appendixRetention ∧
                      |BerryEsseen.rawMean Q| ≤ 10 ^ 5 * BerryEsseen.appendixRetention ∧
                        |BerryEsseen.rawStdDev Q ^ 2 - 1| ≤ 10 ^ 9 * BerryEsseen.appendixRetention ∧
                          |BerryEsseen.rawThirdAbsoluteMoment Q - BerryEsseen.thirdMoment P| +
                                |∫ (x : ℝ), (x - BerryEsseen.rawMean Q) ^ 3 ∂Q - BerryEsseen.signedThirdMoment P| ≤
                              2 * 10 ^ 9 * BerryEsseen.appendixRetention ∧
                            Z.measure =
                                BerryEsseen.standardizedMeasure Q (BerryEsseen.rawMean Q) (BerryEsseen.rawStdDev Q) ∧
                              Z.measure.support ⊆ Set.Icc (-15) 15 ∧
                                BerryEsseen.thirdMoment Z < 2 ∧
                                  BerryEsseen.IsMaximalSpan Z (h / BerryEsseen.rawStdDev Q) ∧
                                    (∀ (u : ℝ),
                                        |u| ≤ BerryEsseen.appendixGlobalCutoff →
                                          1 / 1000 ≤ Metric.infDist u (BerryEsseen.affineLattice 0 (2 * Real.pi / h)) →
                                            ‖MeasureTheory.charFun P.measure u‖ ≤ 1 - BerryEsseen.appendixGlobalGap) ∧
                                      ∀ (ℓ : ℕ),
                                        ↑n / 2 ≤ ↑ℓ →
                                          √↑ℓ * BerryEsseen.globalJitterDiscrepancy P ℓ h ≤
                                            Real.exp (-19 * BerryEsseen.appendixA)
BerryEsseen.effective_identification_with_global_jitter (H : BerryEsseen.ClassicalBerryEsseenBounds)
  (S : BerryEsseen.PublishedSignedSmoothing) (E : BerryEsseen.PublishedEsseenMoment)
  (K : BerryEsseen.PublishedWassersteinDuality) (U : BerryEsseen.PublishedNonuniformBound)
  (P : BerryEsseen.StandardizedLaw) (n : ℕ) (hn : BerryEsseen.appendixNConf ≤ n)
  (hsupp : P.measure.support ⊆ Set.Icc (-6) 6) (z : ℝ)
  (hpos :
    BerryEsseen.cE * BerryEsseen.thirdMoment P < √↑n * (BerryEsseen.normalizedSumCDF P n z - BerryEsseen.normalCDF z)) :
  ∃ Q F h Z,
    MeasureTheory.IsProbabilityMeasure Q ∧
      F.card < 2000 ∧
        Q.support ⊆ ↑F ∧
          (∀ x ∈ F, |x| < 13) ∧
            (∀ x ∈ F, BerryEsseen.appendixRetention ≤ Q.real {x}) ∧
              h ∈ Set.Icc (Real.pi / 500) 5 ∧
                BerryEsseen.IsLatticeSpan Q h ∧
                  (∀ (d : ℝ), BerryEsseen.IsLatticeSpan Q d → d ≤ h) ∧
                    BerryEsseen.wassersteinOne P.measure Q ≤ 10 ^ 5 * BerryEsseen.appendixRetention ∧
                      |BerryEsseen.rawMean Q| ≤ 10 ^ 5 * BerryEsseen.appendixRetention ∧
                        |BerryEsseen.rawStdDev Q ^ 2 - 1| ≤ 10 ^ 9 * BerryEsseen.appendixRetention ∧
                          |BerryEsseen.rawThirdAbsoluteMoment Q - BerryEsseen.thirdMoment P| +
                                |∫ (x : ℝ), (x - BerryEsseen.rawMean Q) ^ 3 ∂Q - BerryEsseen.signedThirdMoment P| ≤
                              2 * 10 ^ 9 * BerryEsseen.appendixRetention ∧
                            Z.measure =
                                BerryEsseen.standardizedMeasure Q (BerryEsseen.rawMean Q) (BerryEsseen.rawStdDev Q) ∧
                              Z.measure.support ⊆ Set.Icc (-15) 15 ∧
                                BerryEsseen.thirdMoment Z < 2 ∧
                                  BerryEsseen.IsMaximalSpan Z (h / BerryEsseen.rawStdDev Q) ∧
                                    (∀ (u : ℝ),
                                        |u| ≤ BerryEsseen.appendixGlobalCutoff →
                                          1 / 1000 ≤ Metric.infDist u (BerryEsseen.affineLattice 0 (2 * Real.pi / h)) →
                                            ‖MeasureTheory.charFun P.measure u‖ ≤ 1 - BerryEsseen.appendixGlobalGap) ∧
                                      (∀ (ℓ : ℕ),
                                          ↑n / 2 ≤ ↑ℓ →
                                            √↑ℓ * BerryEsseen.globalJitterDiscrepancy P ℓ h ≤
                                              Real.exp (-19 * BerryEsseen.appendixA)) ∧
                                        BerryEsseen.wassersteinOne P.measure BerryEsseen.esseenLaw.measure ≤
                                            Real.exp (-7 * BerryEsseen.appendixA) ∧
                                          |h - BerryEsseen.hE| ≤ Real.exp (-7 * BerryEsseen.appendixA) ∧
                                            |BerryEsseen.thirdMoment P - BerryEsseen.betaE| ≤
                                                Real.exp (-6 * BerryEsseen.appendixA) ∧
                                              |BerryEsseen.signedThirdMoment P - BerryEsseen.kappaE| ≤
                                                  Real.exp (-6 * BerryEsseen.appendixA) ∧
                                                |BerryEsseen.signedSecondMoment P -
                                                        BerryEsseen.signedSecondMoment BerryEsseen.esseenLaw| ≤
                                                    Real.exp (-6 * BerryEsseen.appendixA) ∧
                                                  z ^ 2 ≤ Real.exp (-5 * BerryEsseen.appendixA) ∧
                                                    ∀ (ℓ : ℕ),
                                                      ↑n / 2 ≤ ↑ℓ →
                                                        ∀ (x : ℝ),
                                                          √↑ℓ *
                                                              |↑(ProbabilityTheory.cdf
                                                                        ((BerryEsseen.iidSumLaw P.measure ℓ).conv
                                                                          (BerryEsseen.uniformJitter h)))
                                                                    x -
                                                                  BerryEsseen.edgeworthCDF ℓ
                                                                    (BerryEsseen.signedThirdMoment P) (x / √↑ℓ)| ≤
                                                            Real.exp (-19 * BerryEsseen.appendixA)
BerryEsseen.manuscript_effective_full_support (H : BerryEsseen.ClassicalBerryEsseenBounds)
  (E : BerryEsseen.PublishedEsseenMoment) (K : BerryEsseen.PublishedWassersteinDuality)
  (U : BerryEsseen.PublishedNonuniformBound) (P : BerryEsseen.StandardizedLaw) (n : ℕ) (t : ℝ)
  (hN : BerryEsseen.appendixNConf ≤ n) (hatt : BerryEsseen.signedRatio P (n - 1) t = BerryEsseen.extremalConstant n)
  (hv : BerryEsseen.cE < BerryEsseen.extremalConstant n) (hsupp : P.measure.support ⊆ Set.Icc (-6) 6)
  (hd : BerryEsseen.scaledDrop BerryEsseen.extremalConstant n ≤ 20 / √↑n) :
  have μ := MeasureTheory.Measure.map (fun x => BerryEsseen.pE + BerryEsseen.sigmaE * x) P.measure;
  μ.support ⊆
      Set.Icc (-BerryEsseen.appendixEtaStar / 2) (BerryEsseen.appendixEtaStar / 2) ∪
        Set.Icc (1 - BerryEsseen.appendixEtaStar / 2) (1 + BerryEsseen.appendixEtaStar / 2) ∧
    |μ.real (Set.Icc (1 - BerryEsseen.appendixEtaStar / 2) (1 + BerryEsseen.appendixEtaStar / 2)) - BerryEsseen.pE| <
      BerryEsseen.appendixEtaStar
