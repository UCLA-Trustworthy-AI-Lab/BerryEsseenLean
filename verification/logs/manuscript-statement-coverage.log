BerryEsseen.manuscript_extremal_attainment_full (H : BerryEsseen.ClassicalBerryEsseenBounds) (n : ℕ)
  (hC : BerryEsseen.cE < BerryEsseen.extremalConstant (n + 1)) :
  ∃ Q t,
    BerryEsseen.signedRatio Q n t = BerryEsseen.extremalConstant (n + 1) ∧
      sSup (Set.range (BerryEsseen.normalizedDiscrepancy Q (n + 1))) = BerryEsseen.extremalConstant (n + 1) ∧
        1 ≤ BerryEsseen.thirdMoment Q ∧ BerryEsseen.thirdMoment Q < BerryEsseen.momentCutoff
BerryEsseen.manuscript_harmonic_selection (a : ℕ → ℝ) (_ha : Filter.Tendsto a Filter.atTop (nhds 0))
