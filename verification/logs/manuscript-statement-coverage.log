BerryEsseen.influence_contact_equation (H : BerryEsseen.ClassicalBerryEsseenBounds) (P : BerryEsseen.StandardizedLaw)
  (n : ℕ) (t : ℝ) (hattain : BerryEsseen.signedRatio P n t = BerryEsseen.extremalConstant (n + 1))
  (hpos : 0 ≤ BerryEsseen.signedRatio P n t) (x : ℝ) (hx : x ∈ P.measure.support) :
  (↑n + 1) *
      (↑(ProbabilityTheory.cdf (BerryEsseen.iidSumLaw P.measure n)) (t - x) -
        ↑(ProbabilityTheory.cdf (BerryEsseen.iidSumLaw P.measure (n + 1))) t) =
    -√(↑n + 1) * BerryEsseen.standardNormalDensity (t / √(↑n + 1)) * x -
        t / √(↑n + 1) * BerryEsseen.standardNormalDensity (t / √(↑n + 1)) / 2 * (x ^ 2 - 1) +
      BerryEsseen.signedRatio P n t / √(↑n + 1) *
        (|x| ^ 3 - BerryEsseen.thirdMoment P - 3 * BerryEsseen.signedSecondMoment P * x -
          3 / 2 * BerryEsseen.thirdMoment P * (x ^ 2 - 1))
