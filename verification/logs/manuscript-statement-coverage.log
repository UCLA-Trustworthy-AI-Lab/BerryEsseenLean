BerryEsseen.raw_wassersteinThree_variable_jitter_expansion_at_raw (W : BerryEsseen.PublishedWassersteinThreeTopology)
  (S : BerryEsseen.PublishedSignedSmoothing) (μj : ℕ → MeasureTheory.ProbabilityMeasure ℝ)
  (μ : MeasureTheory.ProbabilityMeasure ℝ) (hi : ∀ (j : ℕ), MeasureTheory.Integrable (fun x => |x| ^ 3) ↑(μj j))
  (hiQ : MeasureTheory.Integrable (fun x => |x| ^ 3) ↑μ)
  (hW : Filter.Tendsto (fun j => BerryEsseen.wassersteinThree ↑(μj j) ↑μ) Filter.atTop (nhds 0))
  (hσQ : 0 < BerryEsseen.rawStdDev ↑μ) (n : ℕ → ℕ) (hn : Filter.Tendsto n Filter.atTop Filter.atTop) (d : ℝ)
  (hd : 0 ≤ d ∧ (0 < d → BerryEsseen.IsLatticeSpan (↑μ) d) ∧ ∀ (e : ℝ), BerryEsseen.IsLatticeSpan (↑μ) e → e ≤ d)
  (dj : ℕ → ℝ) (hdj : ∀ (j : ℕ), 0 ≤ dj j) (hdlim : Filter.Tendsto dj Filter.atTop (nhds d)) (ε : ℝ) :
  ε > 0 →
    ∀ᶠ (j : ℕ) in Filter.atTop,
      ∀ (t : ℝ),
        |√↑(n j) *
              (↑(ProbabilityTheory.cdf ((BerryEsseen.iidSumLaw (↑(μj j)) (n j)).conv (BerryEsseen.spanJitter (dj j))))
                  t -
                BerryEsseen.edgeworthCDF (n j)
                  ((∫ (y : ℝ), (y - BerryEsseen.rawMean ↑(μj j)) ^ 3 ∂↑(μj j)) / BerryEsseen.rawStdDev ↑(μj j) ^ 3)
                  ((t - ↑(n j) * BerryEsseen.rawMean ↑(μj j)) / (BerryEsseen.rawStdDev ↑(μj j) * √↑(n j))))| <
          ε
BerryEsseen.wassersteinThree_jitter_envelopes (W : BerryEsseen.PublishedWassersteinThreeTopology)
  (S : BerryEsseen.PublishedSignedSmoothing) (P : ℕ → BerryEsseen.StandardizedLaw) (Q : BerryEsseen.StandardizedLaw)
  (hW : Filter.Tendsto (fun j => BerryEsseen.wassersteinThree (P j).measure Q.measure) Filter.atTop (nhds 0))
  (n : ℕ → ℕ) (hn : Filter.Tendsto n Filter.atTop Filter.atTop) (hn1 : ∀ (j : ℕ), 1 ≤ n j) (h : ℝ) (hh : 0 ≤ h)
  (hspan : 0 < h → BerryEsseen.IsLatticeSpan Q.measure h)
  (hmax : ∀ (d : ℝ), BerryEsseen.IsLatticeSpan Q.measure d → d ≤ h) (ε : ℝ) :
  0 < ε →
    ∀ᶠ (j : ℕ) in Filter.atTop,
      ∀ (x : ℝ),
        BerryEsseen.edgeworthEnvelope (-h) (BerryEsseen.signedThirdMoment (P j)) x - ε ≤
            √↑(n j) * (BerryEsseen.normalizedSumCDF (P j) (n j) x - BerryEsseen.normalCDF x) ∧
          √↑(n j) * (BerryEsseen.normalizedSumCDF (P j) (n j) x - BerryEsseen.normalCDF x) ≤
            BerryEsseen.edgeworthEnvelope h (BerryEsseen.signedThirdMoment (P j)) x + ε
BerryEsseen.wassersteinThree_jitter_limsup (W : BerryEsseen.PublishedWassersteinThreeTopology)
  (S : BerryEsseen.PublishedSignedSmoothing) (P : ℕ → BerryEsseen.StandardizedLaw) (Q : BerryEsseen.StandardizedLaw)
