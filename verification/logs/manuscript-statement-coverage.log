  (hspan : 0 < h → BerryEsseen.IsLatticeSpan Q.measure h)
  (hmax : ∀ (d : ℝ), BerryEsseen.IsLatticeSpan Q.measure d → d ≤ h) :
  Filter.limsup (fun j => BerryEsseen.scaledSumCDFSup (P j) (n j)) Filter.atTop ≤
    (|BerryEsseen.signedThirdMoment Q| + 3 * h) * BerryEsseen.phi0 / 6
BerryEsseen.manuscript_binomial_estimates (W : BerryEsseen.PublishedWassersteinThreeTopology) (K : Set ℝ)
  (hK : IsCompact K) (hKI : K ⊆ Set.Ioo 0 1) :
  (∃ C > 0, ∀ p ∈ K, ∀ (n : ℕ), 1 ≤ n → ∀ (k : ℤ), BerryEsseen.binomialIntegerWeight p n k ≤ C / √↑n) ∧
    (∀ ε > 0,
        ∃ N,
          ∀ n ≥ N,
            ∀ p ∈ K,
              ∀ (k : ℤ),
                |√↑n * BerryEsseen.binomialIntegerWeight p n k -
                      BerryEsseen.standardNormalDensity (BerryEsseen.binomialZ p n k) / √(p * (1 - p))| <
                  ε) ∧
      (∀ M ≥ 0,
          ∀ ε > 0,
            ∃ N,
              ∀ n ≥ N,
                ∀ p ∈ K,
                  ∀ (k : ℤ),
                    |BerryEsseen.binomialZ p n k| ≤ M →
                      |√(↑n * p * (1 - p)) * BerryEsseen.binomialIntegerWeight p n k /
                              BerryEsseen.standardNormalDensity (BerryEsseen.binomialZ p n k) -
                            1| <
                        ε) ∧
        (∀ ε > 0,
            ∃ N,
              ∀ n ≥ N,
                ∀ p ∈ K,
                  ∀ (k : ℤ),
                    |BerryEsseen.binomialUpperBranch p n k -
                            BerryEsseen.binomialUpperEnvelope p (BerryEsseen.binomialZ p n k)| <
                        ε ∧
                      |BerryEsseen.binomialLowerBranch p n k -
                            BerryEsseen.binomialLowerEnvelope p (BerryEsseen.binomialZ p n k)| <
                        ε) ∧
          (∀ ε > 0,
              ∃ M ≥ 0,
                ∀ p ∈ K,
                  ∀ (z : ℝ),
                    M ≤ |z| →
                      |BerryEsseen.binomialUpperEnvelope p z| < ε ∧ |BerryEsseen.binomialLowerEnvelope p z| < ε) ∧
            ∀ ε > 0,
              ∃ N,
                ∀ n ≥ N,
                  ∀ p ∈ K,
                    ∀ (k : ℤ),
                      |↑k - ↑n * p| ≤ 1 / 2 →
                        |BerryEsseen.binomialUpperBranch p n k - BerryEsseen.binomialCentralLimit p| < ε
BerryEsseen.manuscript_two_interval_cluster_stability (W : BerryEsseen.PublishedWassersteinThreeTopology)
  (S : BerryEsseen.PublishedSignedSmoothing) (B : BerryEsseen.PublishedBernoulliBound)
  (I : BerryEsseen.PublishedNonIIDBound) :
  ∃ η ∈ Set.Ioo 0 (1 / 4),
    ∃ N,
      ∀ (μ : MeasureTheory.Measure ℝ),
        MeasureTheory.IsProbabilityMeasure μ →
          μ.support ⊆ Set.Icc (-η) η ∪ Set.Icc (1 - η) (1 + η) →
            |μ.real (Set.Icc (1 - η) (1 + η)) - BerryEsseen.pE| < η ∨
                |μ.real (Set.Icc (1 - η) (1 + η)) - (1 - BerryEsseen.pE)| < η →
              ∀ (n : ℕ), N ≤ n → BerryEsseen.rawNormalizedConstant μ n ≤ BerryEsseen.cE
BerryEsseen.manuscript_one_sided_loss.{u_1} {Ω : Type u_1} [MeasurableSpace Ω] {μ : MeasureTheory.Measure Ω}
  [MeasureTheory.IsProbabilityMeasure μ] {W : Ω → ℝ} (hWm : Measurable W)
  (h4 : MeasureTheory.Integrable (fun x => W x ^ 4) μ) (hmean : ∫ (x : Ω), W x ∂μ = 0)
  (hsmall : ∫ (x : Ω), W x ^ 4 ∂μ ≤ 1 / 160000) {f : ℝ → ℝ} (hf : ContinuousOn f (Set.Icc (-(3 / 5)) (3 / 5)))
  (hfd : DifferentiableOn ℝ f (Set.Ioo (-(3 / 5)) (3 / 5))) (hf0 : f 0 = 0)
  (hd : ∀ x ∈ Set.Ioo (-(3 / 5)) (3 / 5), 3 / 4 ≤ deriv f x ∧ deriv f x ≤ 5 / 4) {u : ℝ} (hu : |u| ≤ 1 / 2) :
  3 / 8 * ∫ (x : Ω), |W x| ∂μ - 176000 * ∫ (x : Ω), W x ^ 4 ∂μ ≤ μ.real {x | u < W x} + f u ∧
    3 / 8 * ∫ (x : Ω), |W x| ∂μ - 176000 * ∫ (x : Ω), W x ^ 4 ∂μ ≤ μ.real {x | W x < u} - f u
BerryEsseen.manuscript_small_cluster_variance_original_parameters (W : BerryEsseen.PublishedWassersteinThreeTopology)
  (S : BerryEsseen.PublishedSignedSmoothing) (B : BerryEsseen.PublishedBernoulliBound) :
  ∃ a b ε lam N,
    a < b ∧
      IsCompact (Set.Icc a b) ∧
        Set.Icc a b ⊆ Set.Ioo 0 (1 / 2) ∧
          BerryEsseen.pE ∈ Set.Ioo a b ∧
            0 < ε ∧
              0 < lam ∧
                ∀ (P Q : BerryEsseen.CenteredFourthLaw),
                  ∀ p ∈ Set.Icc a b,
                    (∀ᵐ (x : ℝ) ∂P.measure, |x| ≤ ε) →
                      (∀ᵐ (x : ℝ) ∂Q.measure, |x| ≤ ε) →
                        ∀ (n : ℕ),
                          N ≤ n →
                            BerryEsseen.accumulatedNoiseVariance P Q p n ≤ lam →
                              BerryEsseen.rawNormalizedConstant (BerryEsseen.twoClusterMeasure P Q p) n ≤
                                  BerryEsseen.rawNormalizedConstant (BerryEsseen.bernoulliMeasure p) n ∧
                                BerryEsseen.rawNormalizedConstant (BerryEsseen.bernoulliMeasure p) n < BerryEsseen.cE ∧
                                  (0 < BerryEsseen.averageNoiseVariance P Q p →
                                    BerryEsseen.rawNormalizedConstant (BerryEsseen.twoClusterMeasure P Q p) n <
                                      BerryEsseen.rawNormalizedConstant (BerryEsseen.bernoulliMeasure p) n)
BerryEsseen.compact_centered_measure_local_mass (W : BerryEsseen.PublishedWassersteinThreeTopology)
  (S : BerryEsseen.PublishedSignedSmoothing) (I : BerryEsseen.PublishedNonIIDBound) (K : Set ℝ) (hK : IsCompact K)
  (hKI : K ⊆ Set.Ioo 0 1) (Lstar R a b : ℝ) (hLstar : 0 < Lstar) (hR : 0 ≤ R) (hab : a < b) :
  ∃ ε > 0,
    ∃ c > 0,
      ∃ N,
        1 ≤ N ∧
          ∀ (μ ν : MeasureTheory.Measure ℝ),
            MeasureTheory.IsProbabilityMeasure μ →
              MeasureTheory.IsProbabilityMeasure ν →
                ∫ (x : ℝ), x ∂μ = 0 →
                  ∫ (x : ℝ), x ∂ν = 0 →
                    (∀ᵐ (y : ℝ) ∂μ, |y| ≤ ε) →
                      (∀ᵐ (y : ℝ) ∂ν, |y| ≤ ε) →
                        ∀ p ∈ K,
                          ∀ (n : ℕ),
                            N ≤ n →
                              Lstar ≤ ↑n * ((1 - p) * ∫ (x : ℝ), x ^ 2 ∂μ + p * ∫ (x : ℝ), x ^ 2 ∂ν) →
                                ∀ (x : ℝ),
                                  |x - ↑n * p| ≤ R * √↑n →
                                    c / √↑n ≤
                                      (BerryEsseen.iidSumLaw
                                            (BerryEsseen.mixtureMeasure μ (MeasureTheory.Measure.map (fun y => 1 + y) ν)
                                              p)
                                            n).real
                                        (Set.Ioo (x + a) (x + b))
