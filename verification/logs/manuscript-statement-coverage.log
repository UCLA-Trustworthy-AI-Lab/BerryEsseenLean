BerryEsseen.influence_contact_at_extremizer (H : BerryEsseen.ClassicalBerryEsseenBounds)
  (P : BerryEsseen.StandardizedLaw) (n : ℕ) (t : ℝ)
  (hattain : BerryEsseen.signedRatio P n t = BerryEsseen.extremalConstant (n + 1))
  (hpos : 0 ≤ BerryEsseen.signedRatio P n t) (y : ℝ) :
