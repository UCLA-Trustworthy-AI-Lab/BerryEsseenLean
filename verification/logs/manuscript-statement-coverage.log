BerryEsseen.manuscript_bounded_extremizing_sequence (H : BerryEsseen.ClassicalBerryEsseenBounds)
  (A : BerryEsseen.PublishedEsseenFixedLawAsymptotic)
  (hviol : ∀ (K : ℕ), ∃ n ≥ K, BerryEsseen.cE < BerryEsseen.extremalConstant n) :
  ∃ n P t,
    StrictMono n ∧
      (∀ (j : ℕ),
          2 ≤ n j ∧
            BerryEsseen.signedRatio (P j) (n j - 1) (t j) = BerryEsseen.extremalConstant (n j) ∧
              BerryEsseen.cE < BerryEsseen.extremalConstant (n j) ∧
                1 ≤ BerryEsseen.thirdMoment (P j) ∧
                  BerryEsseen.thirdMoment (P j) < BerryEsseen.momentCutoff ∧ (P j).measure.support ⊆ Set.Ioo (-10) 10) ∧
        Filter.Tendsto (fun j => BerryEsseen.scaledDrop BerryEsseen.extremalConstant (n j)) Filter.atTop (nhds 0)
