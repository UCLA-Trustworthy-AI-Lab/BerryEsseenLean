  ∃ u,
    StrictMono u ∧
      (∀ (j : ℕ), 1 ≤ u j ∧ 0 < a (u j)) ∧
        Filter.Tendsto (fun j => BerryEsseen.scaledDrop a (u j)) Filter.atTop (nhds 0)
