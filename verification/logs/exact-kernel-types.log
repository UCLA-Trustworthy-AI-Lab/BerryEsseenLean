    (third_integrable : MeasureTheory.Integrable (fun x => |x| ^ 3) measure) (mean_zero : ∫ (x : ℝ), x ∂measure = 0)
    (second_one : ∫ (x : ℝ), x ^ 2 ∂measure = 1) : BerryEsseen.StandardizedLaw
def BerryEsseen.discrepancy : BerryEsseen.StandardizedLaw → ℕ → ℝ → ℝ :=
fun P n x => |((BerryEsseen.iidSumLaw P.measure n) (Set.Iic (√↑n * x))).toReal - BerryEsseen.normalCDF x|
def BerryEsseen.cE : ℝ :=
(3 + √10) / (6 * √(2 * Real.pi))
def BerryEsseen.explicitThreshold : ℕ :=
2 * ⌈Real.exp (10 ^ 17)⌉₊
