  BerryEsseen.StandardizedLaw.second_integrable : MeasureTheory.Integrable (fun x => x ^ 2) self.measure
  BerryEsseen.StandardizedLaw.third_integrable : MeasureTheory.Integrable (fun x => |x| ^ 3) self.measure
  BerryEsseen.StandardizedLaw.mean_zero : ∫ (x : ℝ), x ∂self.measure = 0
  BerryEsseen.StandardizedLaw.second_one : ∫ (x : ℝ), x ^ 2 ∂self.measure = 1
