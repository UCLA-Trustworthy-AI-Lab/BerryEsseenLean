def BerryEsseen.MainClaim : Prop :=
∃ N, 1 ≤ N ∧ ∀ n ≥ N, ∀ (P : BerryEsseen.StandardizedLaw), BerryEsseen.BoundAt P n
def BerryEsseen.ExplicitClaim : Prop :=
∀ n ≥ BerryEsseen.explicitThreshold, ∀ (P : BerryEsseen.StandardizedLaw), BerryEsseen.BoundAt P n
def BerryEsseen.ManuscriptSharpnessClaim : Prop :=
∀ c < BerryEsseen.cE,
  ∀ (N : ℕ), ∃ n, N ≤ n ∧ 1 ≤ n ∧ ∃ x, c < BerryEsseen.normalizedDiscrepancy BerryEsseen.esseenLaw n x
def BerryEsseen.BoundAt : BerryEsseen.StandardizedLaw → ℕ → Prop :=
fun P n => ∀ (x : ℝ), BerryEsseen.discrepancy P n x ≤ BerryEsseen.cE * BerryEsseen.thirdMoment P / √↑n
